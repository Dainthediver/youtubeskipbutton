{
  "manifest_version": 3,
  "name": "YT Skip Button",
  "version": "3.0",
  "description": "Auto-click YouTube skip-ad buttons via main-world injection",
  "permissions": ["scripting", "activeTab"],
  "host_permissions": ["*://*.youtube.com/*"],
  "action": {
    "default_title": "YT Skip Button"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["injected.js", "content-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content-isolated.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}
